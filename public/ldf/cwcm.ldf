Signal_encoding_types {
	AmbLightAdress {
		physical_value, 0, 255, 1.0, 0.0, "";
	}
	AmbLightColor256 {
		physical_value, 0, 255, 1.0, 0.0, "Color";
	}
	AmbLightIntensity64 {
		physical_value, 0, 63, 1.0, 0.0, "Intensity %";
	}
	AmbLightRampFade {
		physical_value, 0, 255, 200.0, 0.0, "milliseconds";
	}
	AmbLightUpdate {
		logical_value, 0, "Immediate update";
		logical_value, 1, "Store and don't update";
		logical_value, 2, "Update to the already stored values";
		logical_value, 3, "Discard";
	}
	BacklightIntensity {
		physical_value, 0, 254, 0.3937, 0.0, "Backlight Intensity %";
		logical_value, 255, "Fault condition Present";
	}
	BacklightStatus {
		logical_value, 0, "Backlight is Off";
		logical_value, 1, "Backlight is On";
	}
	ElPowerStatusCoding {
		logical_value, 0, "KeepActive";
		logical_value, 1, "WarningLowBatteryVolt";
		logical_value, 2, "ShutDown";
		logical_value, 3, "NotUsed";
	}
	LimitedPowerModeCoding {
		logical_value, 0, "False";
		logical_value, 1, "True";
	}
	linear_8 {
		physical_value, 0, 255, 1.0, 0.0, "";
	}
	PartNoBlkNoCoding {
		physical_value, 0, 11, 1.0, 0.0, "Block Number";
	}
	PartNoCoding {
		physical_value, 0, 65535, 1.0, 0.0, "ASCII";
	}
	PowerMode {
		logical_value, 0, "KeyOut";
		logical_value, 1, "KeyRecentlyOut";
		logical_value, 2, "KeyApproved_0";
		logical_value, 3, "PostAccessory_0";
		logical_value, 4, "Accessory_1";
		logical_value, 5, "PostIgnition_1";
		logical_value, 6, "IgnitionOn_2";
		logical_value, 7, "Running_2";
		logical_value, 9, "Crank_3";
	}
	SBVoltCoding {
		physical_value, 0, 255, 0.1, 0.0, "V";
	}
	SerialNoBlkNoCoding {
		physical_value, 0, 7, 1.0, 0.0, "Block Number";
	}
	SerialNoCoding {
		physical_value, 0, 65535, 1.0, 0.0, "ASCII";
	}
}

Signal_representation {
	AmbLightAdress : AmbLightSeqfrom1, AmbLightSeqfrom2, AmbLightSeqfrom3, AmbLightSeqfrom4, AmbLightSeqfrom5,
		AmbLightSeqTo1, AmbLightSeqTo2, AmbLightSeqTo3, AmbLightSeqTo4, AmbLightSeqTo5;
	AmbLightColor256 : AmbLightBlue1, AmbLightBlue2, AmbLightBlue3, AmbLightBlue4, AmbLightBlue5, AmbLightGreen1,
		AmbLightGreen2, AmbLightGreen3, AmbLightGreen4, AmbLightGreen5, AmbLightRed1, AmbLightRed2, AmbLightRed3,
		AmbLightRed4, AmbLightRed5;
	AmbLightIntensity64 : AmbLightIntensity1, AmbLightIntensity2, AmbLightIntensity3, AmbLightIntensity4,
		AmbLightIntensity5;
	AmbLightRampFade : AmbLIghtFade1, AmbLIghtFade2, AmbLIghtFade3, AmbLIghtFade4, AmbLIghtFade5, AmbLightRamp1,
		AmbLightRamp2, AmbLightRamp3, AmbLightRamp4, AmbLightRamp5;
	AmbLightUpdate : AmbLightUpdate1, AmbLightUpdate2, AmbLightUpdate3, AmbLightUpdate4, AmbLightUpdate5;
	BacklightIntensity : BacklightIntensity;
